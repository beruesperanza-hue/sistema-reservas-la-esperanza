generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reservation {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String
  email     String
  telefono  String
  personas  Int
  fecha     DateTime
  hora      String
  ubicacion String   @default("adentro")
  comentarios String?
  estado    String   @default("confirmada")
  // Cargada desde el panel de admin (walk-in / telefónica), sin pasar por las
  // restricciones del formulario público (turno pasado, cierre manual, cupo).
  creadaPorAdmin Boolean @default(false)
  // El cliente ya se sentó. Es informativo por reserva — no afecta el cupo
  // ni a otras reservas del mismo turno (a diferencia de TurnoCierre).
  asistio   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vínculo opcional al cliente del CRM. Nullable: reservas viejas y nuevas
  // sin match de cliente siguen funcionando igual que antes.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@unique([fecha, hora, email])
  @@index([fecha])
  @@index([estado])
  @@index([customerId])
}

// Un cliente del restaurante, independiente de sus reservas (CLIENTE ≠ RESERVA).
// Puede venir de la web, cargado a mano, o importado de un export externo
// (Excel viejo, Woki, Bigbox, Mozrest, Instagram, Facebook).
model Customer {
  id            String   @id @default(cuid())
  nombre        String
  apellido      String?
  email         String?
  telefono      String?
  telefonoPais  String?

  // Fuente de alta: 'web' | 'admin' | 'importado_excel' | 'importado_woki' |
  // 'importado_bigbox' | 'importado_mozrest' | 'instagram' | 'facebook' | ...
  origen        String
  // Solo si origen empieza con 'importado_': referencia al lote de carga.
  importId      String?
  import        CustomerImport? @relation(fields: [importId], references: [id])

  // --- Actividad histórica (importada de un export externo, NO inventada) ---
  visitasHistoricas      Int       @default(0)
  ultimaVisitaHistorica  DateTime?
  primeraVisitaHistorica DateTime?
  gastoPromedio          Float?
  gastoPromedioMoneda    String?
  noShows                Int       @default(0)
  cancelacionesHistoricas Int      @default(0)
  eliminacionesHistoricas Int      @default(0)
  notasHistoricas        String?   // texto libre del Excel viejo, sin estructurar

  // --- Campos libres para segmentación ---
  vip           Boolean   @default(false)
  tags          String[]  @default([])
  notas         String?
  fechaNacimiento DateTime?

  reservas        Reservation[]
  consentimientos ConsentRecord[]
  orders          Order[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([telefono])
  @@index([origen])
}

// Un pedido para retirar en el local, pagado online con Mercado Pago
// (Checkout Pro). subtotal e items.precioUnitario siempre se calculan en el
// servidor desde lib/carta.ts al crear el pedido — nunca se confía en un
// precio mandado por el cliente.
model Order {
  id                String      @id @default(cuid())
  numero            Int         @default(autoincrement())
  nombre            String
  telefono          String
  email             String
  notas             String?
  subtotal          Int
  // retiro | envio_cerca (<=3km) | envio_lejos (>3km) — precios fijos en Settings.
  tipoEntrega       String      @default("retiro")
  costoEnvio        Int         @default(0)
  direccionEnvio    String?
  pisoEnvio         String?
  // pendiente_pago | pagado | en_preparacion | listo_para_retirar | entregado | cancelado
  estado            String      @default("pendiente_pago")
  // "HH:mm" en hora de Buenos Aires, calculada al confirmarse el pago.
  horaListoEstimada String?
  mpPreferenceId    String?
  mpPaymentId       String?
  // Estado crudo devuelto por Mercado Pago, para auditoría/debug.
  mpStatus          String?
  items             OrderItem[]
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([estado])
  @@index([mpPreferenceId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id])
  // slug de SECCIONES_MENU (lib/carta.ts), para trazabilidad histórica.
  seccion        String
  nombre         String
  precioUnitario Int
  cantidad       Int

  @@index([orderId])
}

// Un lote de importación (un Excel/CSV subido una vez). Guarda el mapeo de
// columnas usado y sirve para poder filtrar "clientes importados desde X".
model CustomerImport {
  id              String   @id @default(cuid())
  fuente          String   // 'excel', 'woki', 'bigbox', 'mozrest', etc. (texto libre)
  nombreArchivo   String
  columnMapping   Json     // qué columna del archivo mapeó a qué campo
  filasTotales    Int
  filasImportadas Int
  filasConError   Int
  errores         Json?    // detalle de filas que fallaron, para descargar/revisar
  creadoPor       String?  // referencia a AdminUser en el futuro; por ahora texto
  createdAt       DateTime @default(now())

  clientes        Customer[]
}

// Consentimiento por canal, con historial (no se pisa un registro: cada
// cambio de estado crea una fila nueva, así queda la auditoría completa).
model ConsentRecord {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  canal           String   // 'email' | 'whatsapp'
  estado          String   // 'autorizado' | 'revocado' | 'nunca_solicitado'
  fuente          String?  // 'formulario_reserva', 'importacion_excel', 'admin_manual', etc.
  metodoObtencion String?
  evidencia       String?  // link/referencia si existe (ej. captura, id de checkbox)
  createdAt       DateTime @default(now())

  @@index([customerId, canal])
}

// Filtro guardado. La definición del filtro se guarda como JSON (árbol de
// condiciones AND/OR) y se recalcula en cada consulta — nunca se guarda una
// lista fija de IDs.
model Segment {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  filtro      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Registro de un envío de mail a un segmento (para no perder trazabilidad
// de a quién se le mandó qué y cuándo).
model EmailCampaignLog {
  id            String   @id @default(cuid())
  segmentId     String?
  segmentNombre String   // copia del nombre al momento de enviar, por si el segmento se borra después
  asunto        String
  cuerpoHtml    String
  destinatarios Int
  enviados      Int
  fallidos      Int
  enviadoPor    String?
  createdAt     DateTime @default(now())
}

model Schedule {
  id        String   @id @default(cuid())
  dia       String
  hora      String
  // Capacidad del salón (adentro). Nombre histórico del campo.
  capacidad Int      @default(20)
  // Capacidad de la vereda. 0 = ese turno no tiene mesas afuera.
  capacidadVereda Int @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dia, hora])
  @@index([dia])
}

// Bloqueo puntual de un turno para una fecha específica (no recurrente).
// sector = null cierra el turno completo; 'adentro' o 'vereda' cierra solo ese sector.
// Se usa tanto para cierres manuales (lluvia, evento privado) como para el
// cierre automático de turnos que ya pasaron, que NO se guarda acá — ese se
// calcula al vuelo comparando contra la hora actual de Buenos Aires.
model TurnoCierre {
  id        String   @id @default(cuid())
  fecha     DateTime
  hora      String
  sector    String?
  motivo    String?
  createdAt DateTime @default(now())

  @@unique([fecha, hora, sector])
  @@index([fecha])
}

model Settings {
  id                    String  @id @default(cuid())
  nombreRestaurante     String  @default("La Esperanza")
  emailRestaurante      String  @default("eventoslaesperanza@gmail.com")
  telefonoRestaurante   String  @default("+54 9 11 2182-3702")
  direccionRestaurante  String  @default("Aguirre 526, Villa Crespo, Buenos Aires")
  capacidadPorTurno     Int     @default(20)
  diasAvanzados         Int     @default(60)
  mensajeConfirmacion   String  @default("¡Gracias! Tu reserva fue realizada correctamente.")
  // Pedidos online para retirar en el local (Mercado Pago Checkout Pro).
  aceptaPedidosOnline   Boolean @default(true)
  tiempoPreparacionMin  Int     @default(25)
  pedidoMinimo          Int     @default(0)
  // Envío a domicilio: precio fijo según zona, elegida por el cliente
  // (no se calcula distancia automática — ver lib/pedidosCarta.ts / checkout).
  aceptaEnvioDomicilio  Boolean @default(true)
  costoEnvioCerca       Int     @default(5000)
  costoEnvioLejos       Int     @default(10000)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  email     String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Estado de disponibilidad de un ítem de la carta. lib/carta.ts sigue siendo
// la fuente de contenido (nombre, precio, descripción) — esta tabla solo
// guarda si está activo o no. Sin fila = activo (default true), así que no
// hace falta crear una fila por cada ítem, solo para los que se desactivan.
model MenuItemEstado {
  id        String   @id @default(cuid())
  seccion   String
  nombre    String
  activo    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([seccion, nombre])
}
